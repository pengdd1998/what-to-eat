# .env.example —— 与代码实际读取的环境变量一一对应（收口验证 批3，2026-09-05）
# 复制为 .env 后填真实值。密钥禁入 git/前端/库（SUP-02）；本文件只放名字不放值。
# 注意：app/llm.py 的极简解析不支持行内注释——注释必须独立成行。

# —— LLM 主供（小米 MiMo，ADR-004；app/llm_gateway.py primary 路由）——
# openai_compatible 端点（形如 https://host/v1）与密钥；留空则实时生成走降级链
LLM_BASE_URL=
LLM_API_KEY=

# —— LLM 对照备选路由（仅显式 route=glm / route=qwen 时才读取；
#    主供切换拍板权归人，AGENTS.md 架构红线，勿自行启用）——
GLM_BASE_URL=
GLM_API_KEY=
QWEN_BASE_URL=
QWEN_API_KEY=

# —— LLM 网关 JSONL 留痕（app/llm_gateway.py；默认 logs/llm-gateway-<UTC日期>.jsonl，
#    容器内如需持久化请指向挂载卷路径）——
WTE_LLM_LOG_PATH=

# —— 应用（app/db.py、app/admin.py、app/main.py、app/jump.py）——
# SQLite 路径，默认 ./app.db；容器内 /data/app.db
WTE_DB_PATH=
# prod 时缺 ADMIN_TOKEN/GO_SECRET 直接拒启（密钥守卫，P0 修复批）
WTE_ENV=
# 跳转签名密钥，≥32 字节，prod 必填
GO_SECRET=
# Admin 面 Bearer，≥64 字符，prod 必填（仅回环 8001）
ADMIN_TOKEN=

# —— 构建/冒烟元信息（均有默认值，可选）——
# 版本号与 git sha（app/db.py 落库用；Dockerfile 以 ARG 注入 GIT_SHA）
APP_VERSION=
GIT_SHA=
# 冒烟脚本目标地址（scripts/smoke.py，scripts/smoke_local.sh 会自动注入）
SMOKE_BASE_URL=
SMOKE_ADMIN_URL=
SMOKE_ADMIN_TOKEN=

# —— 告警通道（cron/熔断/磁盘告警双通道，任配其一即生效；core/notify.py）——
SERVERCHAN_SENDKEY=
NTFY_TOPIC=

# —— LLM 对照路由模型名（ping 连通性检测用；ADR-004 附录备选核定）——
GLM_MODEL=
QWEN_MODEL=
LLM_MODEL=

# —— Umami 自部署（profiles obs；密钥仅生产 .env）——
UMAMI_DB_PW=
UMAMI_APP_SECRET=
UMAMI_HASH_SALT=
